@inherits LayoutComponentBase

<a class="um-skip" href="#conteudo">Pular para o conteúdo</a>

<div class="um-shell">
    <SiteHeader />

    @* O header é fixed: quem reserva a altura dele (e a da barra de baixo) é o padding do .um-main. *@
    <main id="conteudo" class="um-main" tabindex="-1">
        @Body
    </main>

    <SiteFooter />
</div>

<BottomNav />

<div id="blazor-error-ui" data-nosnippet>
    Algo deu errado.
    <a href="." class="reload">Recarregar</a>
    <span class="dismiss" role="button" tabindex="0" aria-label="Fechar">×</span>
</div>
