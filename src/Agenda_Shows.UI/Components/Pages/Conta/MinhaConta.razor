@page "/minha-conta"
@attribute [Authorize]
@* SSR estático: a conta é lida do banco (o papel do cookie pode estar até 2 min atrasado — Sessao.ConferirPapelACada). *@
@inject IContas ServicoDeContas

<PageTitle>Minha conta · UMURA</PageTitle>
<HeadContent>
    <meta name="robots" content="noindex" />
</HeadContent>

<div class="um-container">
    <header class="um-pagina-cab">
        <span class="um-eyebrow">Sua conta</span>
        <h1>Minha conta</h1>
    </header>
</div>

<section class="um-section-tight">
    <div class="um-container mc">
        @if (conta is null)
        {
            <div class="um-alert um-alert-warning" role="alert">
                <div>
                    <b>Não achamos os dados da sua conta.</b>
                    <p class="mc-sem-margem">Saia e entre de novo. Se continuar, fale com a equipe da UMURA.</p>
                </div>
            </div>
        }
        else
        {
            <article class="um-card mc-perfil" data-um-motion="card-in" aria-labelledby="mc-nome">
                <span class="um-avatar mc-avatar" aria-hidden="true">@Inicial(conta.Nome)</span>
                <div class="mc-perfil-texto">
                    <h2 id="mc-nome" class="mc-nome">@conta.Nome</h2>
                    <p class="mc-email">@conta.Email</p>
                    <div class="um-row">
                        <span class="um-badge @ClasseDoPapel(conta.Papel)">@NomeDoPapel(conta.Papel)</span>
                        <span class="um-muted mc-desde">Desde @BrazilTime.Format(conta.CriadoEmUtc, "dd/MM/yyyy")</span>
                    </div>
                    @if (conta.Papel != Papel.Usuario && !string.IsNullOrWhiteSpace(conta.NomeDoOrganizador))
                    {
                        <p class="mc-org">Divulga como <b>@conta.NomeDoOrganizador</b></p>
                    }
                </div>
            </article>
        }

        <h2 class="mc-sec">Atalhos</h2>
        <ul class="mc-atalhos" data-um-motion="reveal-group">
            <li>
                <a href="/meus-ingressos" class="um-card um-card-hover mc-atalho">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M3 8a2 2 0 0 0 0 4v4a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-4a2 2 0 0 1 0-4V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2z" /><path d="M14 4v16" stroke-dasharray="2 2" />
                    </svg>
                    <span><b>Meus ingressos</b><small>Os QR codes para a porta do evento</small></span>
                </a>
            </li>
            <li>
                <a href="/favoritos" class="um-card um-card-hover mc-atalho">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                        <path d="M12 20.5s-7.5-4.6-9.6-9.2A5.3 5.3 0 0 1 12 6.2a5.3 5.3 0 0 1 9.6 5.1c-2.1 4.6-9.6 9.2-9.6 9.2z" />
                    </svg>
                    <span><b>Favoritos</b><small>Os eventos que você guardou</small></span>
                </a>
            </li>
            @if (ehOrganizador)
            {
                <li>
                    <a href="/organizador" class="um-card um-card-hover mc-atalho">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <rect x="3" y="4" width="18" height="17" rx="2" /><path d="M3 9h18M8 2v4M16 2v4M12 13v5M9.5 15.5h5" />
                        </svg>
                        <span><b>Área do organizador</b><small>Seus eventos, lotes e vendas</small></span>
                    </a>
                </li>
            }
            @if (ehAdmin)
            {
                <li>
                    <a href="/admin" class="um-card um-card-hover mc-atalho">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                            <path d="M12 3 4 6v6c0 4.5 3.4 8.2 8 9 4.6-.8 8-4.5 8-9V6z" /><path d="m9 12 2 2 4-4" />
                        </svg>
                        <span><b>Painel do admin</b><small>Moderação, contas e números da cidade</small></span>
                    </a>
                </li>
            }
        </ul>

        @if (!ehOrganizador)
        {
            <p class="mc-divulgar">Quer divulgar eventos? Fale com a equipe da UMURA: ela transforma sua conta em conta de organizador.</p>
        }

        <form method="post" action="/sair" class="mc-sair">
            <AntiforgeryToken />
            <button type="submit" class="um-btn um-btn-outline">Sair da conta</button>
        </form>
    </div>
</section>

<style>
    .mc { display: grid; gap: 1rem; max-width: 760px; }
    .mc-sem-margem { margin: 0; }
    .mc-perfil { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; align-items: start; }
    .mc-avatar { width: 56px; height: 56px; font-size: 1.35rem; }
    .mc-perfil-texto { display: grid; gap: 0.35rem; min-width: 0; }
    .mc-nome { margin: 0; font-size: 1.35rem; overflow-wrap: anywhere; }
    .mc-email { margin: 0; color: var(--um-ink-soft); overflow-wrap: anywhere; }
    .mc-desde { font-size: 0.875rem; font-weight: 600; font-variant-numeric: tabular-nums; }
    .mc-org { margin: 0.25rem 0 0; color: var(--um-ink-soft); }
    .mc-sec { margin: 0.75rem 0 0; font-size: 1.15rem; }
    .mc-atalhos { display: grid; gap: 0.75rem; margin: 0; padding: 0; list-style: none; grid-template-columns: repeat(auto-fill, minmax(min(240px, 100%), 1fr)); }
    .mc-atalho { display: flex; align-items: center; gap: 0.9rem; height: 100%; min-height: 72px; color: var(--um-ink); text-decoration: none; }
    .mc-atalho:hover { color: var(--um-ink); }
    .mc-atalho svg { width: 26px; height: 26px; flex: none; color: var(--um-brand); }
    .mc-atalho span { display: grid; gap: 0.15rem; }
    .mc-atalho b { font-family: var(--um-display); color: var(--um-brand); }
    .mc-atalho small { font-size: 0.8125rem; color: var(--um-ink-muted); }
    .mc-divulgar { margin: 0.25rem 0 0; color: var(--um-ink-soft); }
    .mc-sair { margin-top: 0.5rem; }
</style>

@code {
    [CascadingParameter] private Task<AuthenticationState>? Estado { get; set; }

    private UsuarioDto? conta;
    private bool ehOrganizador;
    private bool ehAdmin;

    protected override async Task OnInitializedAsync()
    {
        var user = Estado is null ? null : (await Estado).User;
        var id = Autorizacao.UsuarioId(user);
        conta = id is null ? null : await ServicoDeContas.ObterAsync(id.Value);

        // O papel do banco manda nos atalhos; sem a conta, o que o cookie diz.
        ehAdmin = conta is not null ? conta.Papel == Papel.Admin : Autorizacao.EhAdmin(user);
        ehOrganizador = conta is not null ? conta.Papel != Papel.Usuario : Autorizacao.EhOrganizador(user);
    }

    private static string Inicial(string nome) =>
        string.IsNullOrWhiteSpace(nome) ? "?" : char.ToUpperInvariant(nome.Trim()[0]).ToString();

    private static string NomeDoPapel(Papel p) => p switch
    {
        Papel.Admin => "Admin · equipe UMURA",
        Papel.Organizador => "Organizador",
        _ => "Usuário",
    };

    private static string ClasseDoPapel(Papel p) => p switch
    {
        Papel.Admin => "um-badge-info",
        Papel.Organizador => "um-badge-success",
        _ => "",
    };
}
