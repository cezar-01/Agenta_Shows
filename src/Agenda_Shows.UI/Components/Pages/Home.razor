@page "/"
@using Microsoft.Extensions.Logging
@inject ICatalogo Catalogo
@inject TimeProvider Relogio
@inject ILogger<Home> Log

@* A vitrine "estilo iFood": busca no topo, o convite de instalar o PWA, as bolinhas dos nichos, e os trilhos (ao vivo,
   hoje, destaques, grátis, fim de semana, um por nicho). SSR estático: abre rápido e o Google lê. Nada aqui é interativo —
   o que precisa de circuito (instalar o app) entra como ilha. *@

<PageTitle>Eventos em Curitiba · UMURA</PageTitle>
<HeadContent>
    <meta name="description" content="O que rola hoje em Curitiba: shows, festas, teatro, feiras e a cena independente da cidade, com ingresso na hora." />
</HeadContent>

<div class="um-container um-home"> 
    <header class="um-home-topo"> 
        <div> 
            <span class="um-eyebrow">Curitiba · PR</span> 
            <h1 class="um-home-titulo">O que rola hoje?</h1> 
        </div>
        <form method="get" action="/eventos" role="search" class="um-home-busca"> 
            <label for="home-busca" class="um-visually-hidden">Buscar eventos</label> 
            <div class="um-busca">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" />
                </svg> 
                <input id="home-busca" type="search" name="q" placeholder="Busque show, festa, bairro…"
                       maxlength="80" autocomplete="off" enterkeyhint="search" />
                <button type="submit" class="um-btn um-btn-primary">Buscar</button>
            </div>
        </form>
    </header>

    @* Ilha interativa do convite de instalar o PWA logo no topo da vitrine. *@
    <ConviteInstalar />

    @if (falhou)
    {
        <div class="um-alert um-alert-danger um-home-aviso" role="alert">
            <div>
                <b>Não consegui carregar os eventos agora</b>
                Pode ser a conexão ou o nosso servidor. Tente de novo em instantes.
                <div class="um-home-aviso-acoes"><a href="/" class="um-btn um-btn-outline">Tentar de novo</a></div>
            </div>
        </div>
    }
    else if (vitrine is { } v)
    {
        @if (v.Nichos.Count > 0)
        {
            <nav class="um-nichos" aria-label="Nichos">
                @foreach (var n in v.Nichos)
                {
                    <a href="/nicho/@n.Slug" class="um-nicho">
                        <img src="@FotoDoNicho(n)" alt="" width="72" height="72" loading="lazy" decoding="async" />
                        <span>@n.Nome</span>
                    </a>
                }
            </nav>
        }

        @if (Vazia(v))
        {
            <div class="um-empty">
                <span class="um-eyebrow">Agenda vazia</span>
                <h2>Nada marcado para os próximos dias</h2>
                <p>Ainda não tem evento publicado nesta semana. Dá uma olhada na agenda completa — ou, se você organiza algo, divulgue aqui de graça.</p>
                <div class="um-row um-home-vazio-acoes">
                    <a href="/eventos" class="um-btn um-btn-primary">Ver a agenda completa</a>
                    <a href="/criar-conta?organizador=1" class="um-btn um-btn-outline">Divulgar meu evento</a>
                </div>
            </div>
        }
        else
        {
            <Trilho Titulo="Ao vivo agora" Sub="Acontecendo neste momento em Curitiba" VerTudo="/eventos?quando=aovivo"
                    Eventos="v.AoVivo" Agora="agora" />

            @* O CTA do mapa entre "Ao vivo" e "Hoje" (pedido do Henrich): quem viu o que rola agora já quer ver onde. *@
            <ChamadaDoMapa AoVivo="v.AoVivo.Count" Hoje="v.Hoje.Count" />

            <Trilho Titulo="Hoje" Sub="Ainda dá tempo de ir" VerTudo="/eventos?quando=hoje" Eventos="v.Hoje" Agora="agora" />

            @if (v.Destaques.Count > 0)
            {
                <section class="um-trilho" aria-labelledby="trilho-destaques">
                    <div class="um-trilho-cab">
                        <div>
                            <h2 id="trilho-destaques">Em destaque</h2>
                            <p>Escolhidos a dedo pela equipe da UMURA</p>
                        </div>
                    </div>
                    <div class="um-trilho-faixa is-largo" role="list">
                        @foreach (var e in v.Destaques)
                        {
                            <div role="listitem">
                                <a href="/evento/@e.Slug" class="um-banner">
                                    <img src="@Foto.Cheia(e.ImagemUrl)" alt="" loading="lazy" decoding="async" width="1280" height="720" />
                                    <SeloSituacao InicioUtc="e.InicioUtc" FimUtc="e.FimUtc" Status="e.Status" Agora="agora" />
                                    <h3>@e.Titulo</h3>
                                    <p>@e.LocalNome · @QuandoDoCard(e)</p>
                                </a>
                            </div>
                        }
                    </div>
                </section>
            }

            <Trilho Titulo="Grátis" Sub="Rolê bom sem gastar nada" VerTudo="/eventos?gratis=true" Eventos="v.Gratis" Agora="agora" />

            <Trilho Titulo="No fim de semana" Sub="Sexta, sábado e domingo" VerTudo="/eventos?quando=fds"
                    Eventos="v.FimDeSemana" Agora="agora" />

            <section class="um-chamada um-home-chamada" aria-labelledby="chamada-organizador">
                <h2 id="chamada-organizador">Você organiza eventos?</h2>
                <p>Divulgue grátis na UMURA: cadastre em poucos minutos, venda ingresso e acompanhe quem se interessou.</p>
                <AuthorizeView Roles="@Papeis.OrganizadorOuAdmin">
                    <Authorized>
                        <a href="/organizador" class="um-btn um-btn-accent">Ir para meus eventos</a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="/criar-conta?organizador=1" class="um-btn um-btn-accent">Divulgar meu evento</a>
                    </NotAuthorized>
                </AuthorizeView>
            </section>

            @foreach (var faixa in v.PorNicho)
            {
                <Trilho Titulo="@faixa.Nicho.Nome" Sub="@faixa.Nicho.Descricao" VerTudo="@($"/nicho/{faixa.Nicho.Slug}")"
                        Eventos="faixa.Eventos" Agora="agora" />
            }
        }
    }
</div>

<style>
    .um-home { padding-block: 0.75rem 2.5rem; }
    .um-home-topo { display: grid; gap: 0.75rem; padding-top: 0.5rem; }
    .um-home-titulo { margin: 0.35rem 0 0; font-size: clamp(1.7rem, 6vw, 2.5rem); }
    .um-home .um-nichos { margin-top: 1.25rem; }
    .um-home-aviso { margin-top: 1.25rem; }
    .um-home-aviso-acoes { margin-top: 0.75rem; }
    .um-home-vazio-acoes { justify-content: center; margin-top: 0.5rem; }
    .um-home-chamada { margin-block: 1.75rem 0.5rem; }
    .um-banner .um-selo { justify-self: start; }
    @@media (min-width: 1025px) {
        .um-home-topo { grid-template-columns: minmax(0, 1fr) minmax(0, 560px); align-items: end; gap: 2rem; }
        .um-home-chamada { grid-template-columns: minmax(0, 1fr) auto; align-items: center; column-gap: 2rem; }
        .um-home-chamada h2, .um-home-chamada p { grid-column: 1; }
        .um-home-chamada .um-btn { grid-column: 2; grid-row: 1 / span 2; }
    }
</style>

@code {
    private Vitrine? vitrine;
    private bool falhou;
    private DateTime agora;

    protected override async Task OnInitializedAsync()
    {
        // Um "agora" para a página inteira: todos os selos e rótulos decidem pelo mesmo instante.
        agora = Relogio.GetUtcNow().UtcDateTime;
        try
        {
            vitrine = await Catalogo.VitrineAsync();
        }
        catch (Exception ex)
        {
            // Banco fora do ar não derruba a home: aviso honesto no lugar dos trilhos. Só o tipo vai pro log (sem dado).
            Log.LogWarning("Vitrine indisponível ({Erro}).", ex.GetType().Name);
            falhou = true;
        }
    }

    private static bool Vazia(Vitrine v) =>
        v.AoVivo.Count == 0 && v.Hoje.Count == 0 && v.Destaques.Count == 0 && v.Gratis.Count == 0
        && v.FimDeSemana.Count == 0 && v.PorNicho.Count == 0;

    private static string FotoDoNicho(CategoriaDto n) =>
        string.IsNullOrWhiteSpace(n.ImagemUrl) ? Foto.Card(null) : n.ImagemUrl;

    /// <summary>No banner: quem está ao vivo diz até quando vai; o resto, quando começa.</summary>
    private string QuandoDoCard(EventoCard e) =>
        e.SituacaoEm(agora) == SituacaoDoEvento.AoVivo
            ? Situacao.AteQuando(e.FimUtc, agora)
            : QuandoDoEvento.Rotulo(e.InicioUtc, agora);
}
