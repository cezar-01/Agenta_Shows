@page "/error"
@using System.Diagnostics

<PageTitle>Algo deu errado · UMURA</PageTitle>

<section class="um-section">
    <div class="um-container um-empty">
        <span class="um-eyebrow">Erro</span>
        <h1>Algo deu errado do nosso lado</h1>
        <p>Tente de novo em instantes. Se continuar, avise a gente com o código abaixo.</p>
        @if (ShowRequestId)
        {
            <p class="um-muted">Código: <code class="um-mono">@RequestId</code></p>
        }
        <a href="/" class="um-btn um-btn-primary">Voltar ao mapa</a>
    </div>
</section>

@code {
    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private string? RequestId { get; set; }
    private bool ShowRequestId => !string.IsNullOrEmpty(RequestId);

    protected override void OnInitialized() =>
        RequestId = Activity.Current?.Id ?? HttpContext?.TraceIdentifier;
}
